# Запуск разрешён только против staging/test.
OPERATOR_AI_TARGET_ENV=
OPERATOR_AI_WEB_BASE_URL=
OPERATOR_AI_API_BASE_URL=

# Учётные данные хранятся только в локальном .env.
# Для выбранного пакета достаточно заполнить только участвующие в нём роли.
# Например, TC-012–TC-020 используют РОП и Оператора без Super-admin.
OPERATOR_AI_SUPERADMIN_USERNAME=
OPERATOR_AI_SUPERADMIN_PASSWORD=
OPERATOR_AI_ROP_USERNAME=
OPERATOR_AI_ROP_PASSWORD=
OPERATOR_AI_OPERATOR_USERNAME=
OPERATOR_AI_OPERATOR_PASSWORD=

# Ежедневный UAT: внешние ресурсы включаются только явно.
OPERATOR_AI_LANDING_BASE_URL=
OPERATOR_AI_UAT_ALLOW_DEMO_MUTATION=false
OPERATOR_AI_UAT_ALLOW_PLAN_MUTATION=false
OPERATOR_AI_UAT_ALLOW_SHARED_CONFIG_MUTATION=false
OPERATOR_AI_UAT_AMOCRM_DOMAIN=
OPERATOR_AI_UAT_AMOCRM_CLIENT_ID=
OPERATOR_AI_UAT_AMOCRM_CLIENT_SECRET=
OPERATOR_AI_UAT_AMOCRM_REDIRECT_URI=
OPERATOR_AI_UAT_AMOCRM_ACCESS_TOKEN=
OPERATOR_AI_UAT_ONLINEPBX_DOMAIN=
OPERATOR_AI_UAT_ONLINEPBX_API_KEY=
OPERATOR_AI_UAT_ONLINEPBX_EXTENSION=
OPERATOR_AI_UAT_SAFE_PHONE=

# Telegram-доставка. Значения хранятся только в локальном .env/CI secrets.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=
